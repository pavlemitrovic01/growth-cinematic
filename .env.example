# Build-time origin. Keep this local until a preview domain is assigned.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_LIVE=false
# Neon Postgres. Vercel Marketplace integracija ubacuje ovu promenljivu sama u sva tri
# okruzenja; lokalno je upisi u .env.local. Bez nje rute rade, ali se lead ne upisuje
# trajno i kocnica pada na slabiji in-memory sloj.
DATABASE_URL=
# Optional delivery configuration; never commit real credentials.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=
LEAD_FROM_EMAIL=
# Ukljucuje consent baner i CPRA kontrole. Ostaviti prazno dok baner ne postoji.
NEXT_PUBLIC_CONSENT_REQUIRED=false
